    {"id": "T-FUL-1", "lane": "FUL", "severity": "P2", "condition": "核电核准、燃气供需、容量市场与公用事业监管变化"},
    {"id": "T-EDG-1", "lane": "EDG", "severity": "P2", "condition": "边缘/推理节点容量与延迟数据变化、推理算力价格趋势"},
