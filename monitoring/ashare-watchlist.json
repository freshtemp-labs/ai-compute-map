{
  "manifestVersion": "1.0.0",
  "updated": "2026-08-02",
  "title": "AI Compute Map × 中国A股 SALP规则每日监控清单",
  "purpose": "供外部 agent（Hermes Agent / OpenClaw 等）每日加载执行的机器可读监控清单。以 Situational Awareness LP 公开投资框架为规则源，对 92 只 A 股标的（AAAAA-E 共25级）进行物理产能口径的日常监控。",
  "notInvestmentAdvice": true,
  "timezone": "Asia/Shanghai",
  "suggestedRunWindow": "A股收盘后 15:40-16:30 CST；P0 政策事件即时触发",
  "frameworkSources": [
    "research/situational-awareness-lp-2026-q1.md",
    "research/ai-infrastructure-fund-comparison-2026-08.md",
    "research/ashare-target-25-tier-mapping-2026-08.md",
    "info.md"
  ],
  "lanes": [
    {"id": "ACC", "name": "AI加速器供给", "coreFields": ["型号", "已/待交付数量", "交期", "ASP", "出口许可", "绑定的晶圆/HBM/封装"], "salpNote": "MW不能直接代表可用AI加速器"},
    {"id": "MEM", "name": "HBM与存储", "coreFields": ["HBM月度堆叠产能", "良率", "客户分配", "交期", "企业级NAND/SSD"], "salpNote": "直接限制加速器交付与训练吞吐"},
    {"id": "PKG", "name": "先进封装/基板", "coreFields": ["CoWoS/SoIC/InFO产能", "2.5D/3D", "OSAT稼动率", "ABF", "良率", "投产日"], "salpNote": "先进晶圆与HBM变成AI系统的汇合瓶颈"},
    {"id": "NET", "name": "网络/光互连", "coreFields": ["800G/1.6T端口出货", "NIC/DPU", "光模块订单与交期", "GPU网络配比", "fabric架构"], "salpNote": "集群扩展受网络而非单颗GPU限制"},
    {"id": "SRV", "name": "服务器/机架", "coreFields": ["GPU服务器交期", "机架密度", "PDU/UPS/busbar", "电源订单", "验收周期"], "salpNote": "芯片与数据中心之间的实体集成层"},
    {"id": "IDC", "name": "Neocloud/AIDC", "coreFields": ["已并网MW", "可用MW", "已签约MW", "GPU利用率", "客户合同", "债务"], "salpNote": "拥有园区不等于能交付AI算力"},
    {"id": "PWR", "name": "电力/并网", "coreFields": ["firm MW", "并网状态", "energization日期", "变压器/输电交期", "现场发电", "PPA"], "salpNote": "规划容量与真实IT Load的差异主要在这里"},
    {"id": "CLG", "name": "冷却/用水", "coreFields": ["液冷比例", "CDU/冷板交期", "WUE", "取水许可", "气候风险"], "salpNote": "高密度机架使PUE单指标失真"},
    {"id": "LIT", "name": "光刻/半导体设备", "coreFields": ["设备订单", "验证/交付进度", "国产化率", "出口许可变化"], "salpNote": "制造自主化的先行指标"},
    {"id": "FAB", "name": "晶圆代工/制造", "coreFields": ["产能利用率", "先进制程良率", "扩产计划", "出口管制影响"], "salpNote": "供给能否合法按时变现"},
    {"id": "REE", "name": "稀土/永磁", "coreFields": ["配额", "出口管制", "磁材订单", "海外产能进展"], "salpNote": "地缘/政策变量而非产能瓶颈变量"},
    {"id": "MAT", "name": "电网与数据中心使能材料", "coreFields": ["铜/铝供给", "线缆交期", "变压器产能与交期", "特种钢"], "salpNote": "稀土不覆盖所有材料（对照基金补盲第6条）"},
    {"id": "FUL", "name": "燃料/核电/公用事业", "coreFields": ["核电核准与基荷", "燃气供需", "公用事业监管", "容量市场"], "salpNote": "电力不只是MW（对照基金补盲第1条）"},
    {"id": "EDG", "name": "推理/边缘", "coreFields": ["边缘节点容量", "端到端延迟", "互联密度", "城域节点"], "salpNote": "训练不等于推理（Global X 视角）"},
    {"id": "POL", "name": "政策/资本风险（横切）", "coreFields": ["产品×原产地×目的地规则", "客户集中度", "CAPEX", "债务", "许可"], "salpNote": "横切维度，适用于全部标的，事件即时触发"}
  ],
  "salpRules": [
    {"id": "R1", "rule": "物理口径优先：只记录 MW、台、端口、吨、产能利用率、交期等物理量；股价、市值、基金持仓报告值不得作为产能或供给信号。", "origin": "SALP研究文档：13F报告值不能当作工厂产能或数据中心MW"},
    {"id": "R2", "rule": "瓶颈优先：监控资源按 NET/SRV/CLG/PWR/MEM/PKG > ACC/FAB/IDC > LIT/REE/MAT/FUL/EDG 排序分配；A/B级标的每日覆盖，C级每周，D级每月，E级季度或事件驱动。", "origin": "SALP核心论点：稀缺资源=可并网电力、可上线园区、HBM、光互连、执行能力"},
    {"id": "R3", "rule": "电力分级核实：对任何容量声明，区分 planned → secured → interconnected → energized → firm IT load 五级状态，逐级标注证据。", "origin": "对照基金文档：secured power → interconnection → energised → firm IT load"},
    {"id": "R4", "rule": "证据等级强制标注：定期报告/公告 > 监管文件/招标中标/海关 > 交易所互动平台 > 行业数据商 > 券商研报 > 媒体。低等级证据不得单独触发 P0/P1 告警。", "origin": "项目数据层可信度评级：一级来源>二级来源>估算"},
    {"id": "R5", "rule": "主题共识提级：当两个以上独立来源（公司披露+行业数据+政策）同时指向同一环节异动时，提高该环节研究优先级并复核相关标的层级。", "origin": "对照基金文档：多来源主题共识信号"},
    {"id": "R6", "rule": "衍生品不作方向解读：对任何基金/机构信号（含SALP自身），期权 value 既不是权利金也不是净敞口，禁止据此断言多空方向。", "origin": "SALP 13F读法"},
    {"id": "R7", "rule": "历史快照标记：一切机构持仓/基金信号必须带报告期标记，默认视为历史快照，不代表当前仓位；报告期后事件单独标注。", "origin": "SALP 13F为历史信号快照（Citadel出售事件案例）"},
    {"id": "R8", "rule": "训练≠推理：IDC/EDG 赛道信号须区分训练园区（电力/规模导向）与推理节点（延迟/邻近性导向），不得混用指标。", "origin": "Global X 研究视角（对照基金补盲第4条）"},
    {"id": "R9", "rule": "政策即时触发：出口管制、稀土配额/管制、原产地规则、数据主权、并网许可等政策事件对全部关联标的即时触发 P0 评估，不受 cadence 限制。", "origin": "SALP观察域：政策/资本风险"},
    {"id": "R10", "rule": "容量→收入验证：IDC/SRV 赛道必须交叉验证预租赁率、上架率、合同期限、锚定客户集中度；只有容量无合同 = 降级信号。", "origin": "对照基金补盲第3条：合同容量经济性"}
  ],
  "cadencePolicy": {
    "A": {"frequency": "daily", "depth": "full", "note": "全部核心字段+公告扫描"},
    "B": {"frequency": "daily", "depth": "standard", "note": "核心字段+公告扫描"},
    "C": {"frequency": "weekly", "day": "Monday", "depth": "standard", "note": "公告与触发器常开"},
    "D": {"frequency": "monthly", "depth": "light", "note": "事件驱动为主"},
    "E": {"frequency": "quarterly", "depth": "light", "note": "事件驱动与层级复核时覆盖"},
    "POL": {"frequency": "realtime", "note": "横切维度，全部层级即时评估"}
  },
  "severityPolicy": {
    "P0": {"meaning": "政策突变/重大合同签署或终止/出口管制变化", "sla": "即时告警", "minEvidence": "一级"},
    "P1": {"meaning": "订单、交期、产能利用率、签约MW等核心字段显著异动", "sla": "当日digest", "minEvidence": "二级"},
    "P2": {"meaning": "趋势性变化（连续两期数据同向）", "sla": "周报", "minEvidence": "三级"},
    "P3": {"meaning": "层级重评候选", "sla": "季度复核", "minEvidence": "多来源共识"}
  },
  "alertTriggers": [
